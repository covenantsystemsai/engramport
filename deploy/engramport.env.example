# EngramPort server settings for the D-06 hosting design (docs/hosting.md).
#
# A template: every setting the server reads in production, with no values for
# anything secret. Never put a real value in this file or any copy of it in the
# repository. In ECS, the plain settings below go in the task definition and
# the three secrets come from AWS Secrets Manager.

# ── Fixed by the image (Dockerfile); listed so nothing is a surprise ────────
ENGRAMPORT_MODE=http
ENGRAMPORT_PORT=8080
ENGRAMPORT_STORE=postgres

# ── Secrets: from AWS Secrets Manager only, never written here ──────────────
# engramport/<env>/database-url: the app role's connection string through
# Supabase's session-mode pooler (port 5432 on the region's pooler host),
# for the engramport_app role, never the postgres or service role.
ENGRAMPORT_DATABASE_URL=
# engramport/<env>/key-pepper: at least 32 random bytes, hex or base64. API
# keys are stored only as hashes peppered with it, and page visits are sealed
# with it. Never rotate it casually; keep an offline copy.
ENGRAMPORT_KEY_PEPPER=
# engramport/<env>/embed-secret: the shared secret of the `embed` Edge Function
# (docs/embeddings.md).
ENGRAMPORT_EMBED_SECRET=

# ── Database TLS ─────────────────────────────────────────────────────────────
# Supabase's CA certificate, carried in the image (deploy/certs/README.md).
ENGRAMPORT_DATABASE_CA_FILE=/app/certs/supabase-ca.crt

# ── Embeddings (gte-small, inside Supabase) ──────────────────────────────────
ENGRAMPORT_EMBED_URL=https://<project ref>.supabase.co/functions/v1/embed
# Leave unset: Max uses gte-small, and no text goes to OpenAI.
# OPENAI_API_KEY=

# ── Sign-in (docs/oauth-setup.md) ────────────────────────────────────────────
ENGRAMPORT_OAUTH=true
# https and the host only, nothing after it.
ENGRAMPORT_PUBLIC_URL=https://<domain>
ENGRAMPORT_SUPABASE_URL=https://<project ref>.supabase.co
# Public by design (Project Settings > API Keys); configuration, not a secret.
ENGRAMPORT_SUPABASE_PUBLISHABLE_KEY=
# MCP clients allowed to receive OAuth codes. Default claude.ai,claude.com.
# Add another client's exact host only after its live test.
# ENGRAMPORT_OAUTH_REDIRECT_HOSTS=claude.ai,claude.com

# ── Pages: each off until its own decision turns it on ──────────────────────
ENGRAMPORT_APPROVAL_PAGE=false
ENGRAMPORT_ERASURE_PAGE=false
ENGRAMPORT_EXPORT_PAGE=false
ENGRAMPORT_RESTORE_PAGE=false
ENGRAMPORT_CELL_ERASURE_PAGE=false
ENGRAMPORT_ACCEPT_PAGE=false
ENGRAMPORT_GRANT_PAGE=false

# ── Never set in production ──────────────────────────────────────────────────
# ENGRAMPORT_ALLOW_LOCAL_BACKEND: local development only.
# ENGRAMPORT_API_URL, ENGRAMPORT_API_KEY, ENGRAMPORT_NAMESPACE, EIDETIC_*,
# GCLOUD_*, OIDC_*: the old eidetic-v3 backend, not used by the Postgres store.
